[
  {
    "id": "deploy-hook",
    "execute-command": "/app/deploy.sh",
    "command-working-directory": "/app",
    "response-message": "Deploying swing-bot...",
    "trigger-rule": {
      "match": {
        "type": "payload-hash-sha256",
        "secret": "${WEBHOOK_SECRET}",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
